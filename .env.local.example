# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local NÃO vai para o git (ver .gitignore).

# --- Supabase (auth + banco) ---
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Unsplash (busca de imagens) ---
# https://unsplash.com/developers — registre uma aplicação (tier Demo: 50 req/hora).
# Usada a partir da Fase 2 pela Route Handler `src/app/api/search` (só no servidor).
# SEM prefixo NEXT_PUBLIC_ de propósito: a chave não pode ir para o bundle do client.
UNSPLASH_ACCESS_KEY=
