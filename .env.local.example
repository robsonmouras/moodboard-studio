# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local NÃO vai para o git (ver .gitignore).

# --- Supabase (auth + banco) ---
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Fontes de imagem (busca agregada — src/lib/image-sources) ---
# A busca combina o resultado de todas as fontes com chave preenchida. Basta uma
# para a busca funcionar; a falta de uma fonte só a tira da rodada.
# TODAS SEM prefixo NEXT_PUBLIC_ de propósito: as chaves não vão para o bundle do client.

# Unsplash — https://unsplash.com/developers — registre uma aplicação (tier Demo: 50 req/hora).
UNSPLASH_ACCESS_KEY=

# Pexels — https://www.pexels.com/api/ — "Get Started", confirme o e-mail, copie a
# chave em "Your API Key" (plano padrão: ~200 req/hora, 20.000/mês).
PEXELS_API_KEY=
