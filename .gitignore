# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nunca versionar segredos reais) — só o .example vai pro git
.env
.env.*
!.env.example
!.env.local.example

# segredos / credenciais avulsas
*.pem
*.key
*.p12
*.pfx
*_rsa
*_rsa.pub
secrets.json
service-account*.json
.supabase/

# vercel
.vercel
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

